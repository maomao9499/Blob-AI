{
  "name": "blob-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "config": { "forge": "./forge.config.cjs" },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "node scripts/start-desktop.mjs",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:desktop": "npm run build:electron && node --test electron/tests/*.test.cjs scripts/*.test.mjs",
    "build:server": "mvn -f ../server/pom.xml package",
    "prepare:resources": "node scripts/prepare-resources.mjs",
    "make": "npm run build && npm run build:electron && npm run build:server && npm run prepare:resources && electron-forge make --platform=darwin --arch=arm64",
    "verify:package": "node scripts/verify-package.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "axios": "1.20.0",
    "element-plus": "2.14.5",
    "md-editor-v3": "6.5.6",
    "sanitize-html": "2.17.7",
    "pinia": "4.0.3",
    "vue": "3.5.42",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron/asar": "4.3.0",
    "@playwright/test": "1.63.0",
    "@types/sanitize-html": "2.16.1",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.5.0",
    "jsdom": "30.0.1",
    "electron": "44.2.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "vue-tsc": "3.3.11"
  }
}
